
{
  "name": "heavy",
  "pico_board": "pico",
  "core_freq": 240000,
  "audio_mode": "I2S",
  "sample_rate": 48000,
  "channel": 2,
  "buffer_size": 64,
  "i2s_data_pin": 9,
  "i2s_bclk_pin": 10,
  "pwm_pin": 10,
  "voice_count": 1,
  "midi_mode": "usb",
  "console": true,

  "inputs": {

    "adc_pins": [
      { "name": "knob", "pin": 26, "type": "knob" },
      { "name": "pot", "pin": 27, "type": "knob" },
      { "name": "cv1", "pin": 28, "type": "cv_in" }
    ],

    "buttons": [
      { "name": "btn1", "pin": 23, "mode": "bang" },
      { "name": "btn2", "pin": 11, "mode": "toggle" },
      { "name": "btn3", "pin": 14, "mode": "switch" }
    ],

    "gate_in": [
      { "name": "gate_in", "pin": 15 }
    ],

    "encoders": [
      { "name": "enc", "pin_a": 14, "pin_b": 15 }
    ],

    "joystick": [
      { "name": "joy", "joy_x": 26, "joy_y": 27, "midi_range": true }
    ],

  "sensors": {
       
      "cny70": [
       { "name": "cny", "adc_pin": 28 }
      ],
       
       "mpr121": [ 
        { "name": "mpr1", "i2c_bus": "i2c0", "sda": 4, "scl": 5, "irq": 6, "addr_index": 0 }
      ],
       
       "hc-sr04": [
        { "name": "distance", "trigger": 2, "echo": 3}
      ],

      "hx710": [
    {
        "name": "air",
        "sck_pin": 14,
        "dout_pin": 12,
        "min_raw": 704000,
        "max_raw": 1004000,
        "fall_factor": 0.95,
        "send_interval": 20,
        "rise_step": 2,
        "mode": "MIDI"
    }
]
    
  }
},

"outputs": {
    "gate_out": [
      { "name": "gate", "pin": 2, "mode": "gate" },
      { "name": "trigger", "pin": 3, "mode": "trigger" }
    ],
    "mcp4725": [
      {
        "name": "note_out",
        "sda_pin": 6,
        "scl_pin": 7,
        "mode": "note"
      },
      {
        "name": "cv_out",
        "sda_pin": 6,
        "scl_pin": 7,
        "mode": "cv"
      }
    ]
  },

  "leds": [
    { "name": "led1", "pin": 25, "mode": "pd" },
    { "name": "status", "pin": 24, "mode": "status" },
    { "name": "clock", "pin": 23, "mode": "clock" },
    { "name": "ledRGB", "pin": 16, "is_rgb": true, "mode": "midi" }
  ],  
  
  "masterfx": {
    "delay": false,
    "reverb": false,
    "limiter": true
  },

  "display": {
      "enabled": false,
      "driver": "ssd1306",
      "i2c_bus": "i2c0",
      "sda": 0,
      "scl": 1,
      "width": 128,
      "height": 64,
      "mode": "console"
    },
  
   "web": {
      "enabled": false,
      "active_mode": 0,
      "ap": {
        "mode_id": 0,
        "ssid": "pikoPD",
        "password": "12345678"
      },
      "sta": {
        "mode_id": 1,
        "ssid": "",
        "password": ""
      },
      "mdns_name": "pikopd",
      "http_port": 80,
      "osc_enabled": false,
      "osc_port": 8000
    }
  }

